<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- fonia.exe. Plain net10.0 (no runtime identifier): it runs on Linux with the mock source and with
         replay, and the native SimConnect.dll sits in runtimes/win-x64/native, loaded only by the msfs source. -->
    <AssemblyName>fonia</AssemblyName>
    <RootNamespace>Fonia.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fonia.Audio\Fonia.Audio.csproj" />
    <ProjectReference Include="..\Fonia.Core\Fonia.Core.csproj" />
    <ProjectReference Include="..\Fonia.Data\Fonia.Data.csproj" />
    <ProjectReference Include="..\Fonia.Sim.Mock\Fonia.Sim.Mock.csproj" />
    <ProjectReference Include="..\Fonia.Sim.Msfs\Fonia.Sim.Msfs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fonia.App.Tests" />
  </ItemGroup>

</Project>
