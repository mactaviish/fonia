<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <!-- The version of the app and of the installer (tools/publish.ps1 reads it from fonia.exe). Change it for a release. -->
    <Version>0.1.0</Version>
    <Copyright>Copyright 2026 Leonardo Yuri Dalla Corte Brancalione</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>

    <!-- Lets the whole solution build on Linux (CI) even with net10.0-windows projects. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- Analyzers -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
