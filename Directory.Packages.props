<Project>

  <PropertyGroup>
    <!-- Central Package Management: versions live here, projects reference packages without Version. -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Runtime">
    <!-- SimConnect.NET: MIT (beta; pinned on purpose, see docs/decisions/simconnect.md).
         Logging.Abstractions: MIT, only the ILogger abstraction.
         Logging.Console: MIT, console logger of the app.
         NAudio.WinMM: MIT, microphone capture (and later playback) through the Windows waveIn/waveOut API;
         pulls NAudio.Core (MIT). Targets netstandard2.0, so it compiles everywhere and only runs on Windows.
         Whisper.net: MIT, local speech recognition over whisper.cpp; the models (ggml, from whisper.cpp) are MIT too.
         Whisper.net.Runtime: MIT, the CPU build of the native library. Runtime.Vulkan: MIT, the optional GPU build.
         Microsoft.ML.OnnxRuntime: MIT, runs the Kokoro voice model on the CPU (its native library ships in the package).
         See docs/decisions/speech.md. -->
    <PackageVersion Include="SimConnect.NET" Version="0.2.2" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageVersion Include="NAudio.WinMM" Version="2.2.1" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
    <PackageVersion Include="Whisper.net" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- xunit.v3: Apache-2.0; Shouldly: BSD-3-Clause; TimeProvider.Testing: MIT. xunit.v3 runs on Microsoft.Testing.Platform (see global.json). -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
  </ItemGroup>

</Project>
